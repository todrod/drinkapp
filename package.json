    "test:party-gag": "node --require ./tests/register-typescript.cjs --test tests/party-gag.test.cjs",
    "test:install": "node --require ./tests/register-typescript.cjs --test tests/install.test.cjs tests/pwa.test.cjs tests/updates.test.cjs",
    "test": "npm run test:shake && npm run test:discovery && npm run test:hosting && npm run test:local-bars && npm run test:random-source && npm run test:party-gag && npm run test:install"
